  {
    "_meta": {
      "lookup_version": "2026-05-25",
      "schema_notes": "Each entry pairs an SA (FRED-hosted) identifier with an NSA (Census M3 EITS API) identifier. NSA fields use `category_code` + `data_type_code`, which are the two dimensions the Census API requires. SA uses FRED series_id. FRED rarely mirrors NSA M3 series; use the Census EITS endpoint for NSA.",
      "census_api": {
        "endpoint": "https://api.census.gov/data/timeseries/eits/m3",
        "required_params": {
          "get": "cell_value,data_type_code,time_slot_id,seasonally_adj,category_code",
          "for": "us:*",
          "seasonally_adj": "no | yes",
          "category_code": "(from lookup entry)",
          "data_type_code": "(from lookup entry)",
          "time": "YYYY (returns all months for that year)",
          "key": "(Census API key)"
        },
        "gotchas": {
          "duplicate_columns": "Response header contains duplicate column names; time is at index 8 (not 5). Parse by index, not by name.",
          "for_clause_required": "Omitting for=us:* returns HTTP 400 'missing for argument'.",
          "empty_response": "HTTP 204 with empty body means no data for that filter combo; check before JSON parse.",
          "year_returns_months": "time=YYYY returns 12 monthly rows, not an annual aggregate."
        },
        "data_type_codes": {
          "VS": "Value of Shipments",
          "NO": "New Orders",
          "UO": "Unfilled Orders",
          "TI": "Total Inventories",
          "FI": "Finished Goods Inventories",
          "MI": "Materials & Supplies Inventories",
          "WI": "Work-in-Process Inventories",
          "IS": "Inventories-to-Shipments Ratio",
          "US": "Unfilled Orders-to-Shipments Ratio",
          "MPCVS": "Month % Change — Shipments",
          "MPCNO": "Month % Change — New Orders",
          "MPCUO": "Month % Change — Unfilled Orders",
          "MPCTI": "Month % Change — Inventories",
          "MPCFI": "Month % Change — Finished Goods Inv",
          "MPCMI": "Month % Change — Materials Inv",
          "MPCWI": "Month % Change — WIP Inv"
        },
        "aggregate_category_codes": {
          "MTM": "Total Manufacturing",
          "MDM": "Durable Goods",
          "MNM": "Nondurable Goods",
          "MTU": "Total Mfg excl. Transportation",
          "MXD": "Total Mfg excl. Defense",
          "MXT": "Total Mfg excl. Transportation & Defense",
          "CDG": "Capital Goods",
          "COG": "Capital Goods excl. Aircraft",
